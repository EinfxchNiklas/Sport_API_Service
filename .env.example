# .env.example – Vorlage für lokale Umgebungsvariablen.
# Kopiere diese Datei als ".env" und trage deine Werte ein.
# ACHTUNG: Die echte .env niemals in Git einchecken!

# Laufzeitumgebung (development | staging | production)
APP_ENV=development

# PostgreSQL-Verbindungsstring für lokale Docker-Instanz
# Standardkonfiguration: Nutzer "sport", Passwort "sport", Datenbank "sportdb", Port 5432
DATABASE_URL=postgresql+psycopg://sport:sport@localhost:5432/sportdb

# Admin-API-Schlüssel zum Schutz administrativer Endpunkte – bitte ändern!
ADMIN_API_KEY=change-me-admin-key

# Signier-Schlüssel für das Admin-UI-Session-Cookie (/admin) – bitte ändern!
SESSION_SECRET=change-me-session-secret

# Log-Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Scheduler beim Start aktivieren (True | False)
ENABLE_SCHEDULER=False

# OpenF1 – kostenlose Formel-1-Live-API (kein Key nötig)
# Dokumentation: https://openf1.org
OPENF1_BASE_URL=https://api.openf1.org/v1

# API-Football – Fußballdaten (Registrierung: https://www.api-football.com/)
# Nach der Registrierung findest du deinen Key im Dashboard unter "My Account"
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Tank01 NFL – Live-NFL-Statistiken über RapidAPI (https://rapidapi.com/)
# Suche nach "Tank01 NFL Live In Game Real Time Statistics" und abonniere die API
TANK01_KEY=
TANK01_HOST=tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com

# Zeitzone für Zeitstempel (Standard: Europe/Berlin)
TIMEZONE=Europe/Berlin
